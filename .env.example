# All optional; no credentials needed for local parent practice/manual imports.
# Copy to .env.local and restart. NEVER prefix secrets with NEXT_PUBLIC_.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# Explicitly select compatible models with vision/JSON/audio support for your account.
VISION_MODEL=
STRUCTURING_MODEL=
ASR_MODEL=
TTS_MODEL=
TTS_VOICE=alloy
# Public deployment: protect whole site with hosting authentication.
# Optional API token for programmatic API access; UI does not store tokens.
APP_ACCESS_TOKEN=
