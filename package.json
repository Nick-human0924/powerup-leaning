{
  "name": "andy-english-companion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/bootstrap.mjs",
    "predev": "node scripts/bootstrap.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "node scripts/bootstrap.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "pretest": "node scripts/bootstrap.mjs",
    "test": "vitest run",
    "test:public": "vitest run tests/public.test.ts tests/providers.test.ts",
    "test:e2e": "playwright test",
    "pretypecheck": "node scripts/bootstrap.mjs",
    "typecheck": "tsc --noEmit",
    "prepare:reference": "node scripts/extract-reference.mjs && node scripts/prepare-seed.mjs && node scripts/prepare-worker.mjs"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "dexie": "^4.0.11",
    "zod": "^3.25.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "vitest": "^3.2.0",
    "@playwright/test": "^1.55.0",
    "fake-indexeddb": "^6.2.0"
  }
}
